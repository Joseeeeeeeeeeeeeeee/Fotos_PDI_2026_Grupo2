import cv2 as cv
import numpy as np
import matplotlib.pyplot as plt
from skimage.filters import threshold_multiotsu

image=cv.imread('IMG_20260901_161409949.jpg')
gray=cv.cvtColor(image,cv.COLOR_BGR2GRAY)

#Segmentacion normal:
T=128
_, masc=cv.threshold(gray,T,255,cv.THRESH_BINARY)

cv.imwrite('segmentacionT128.jpg',masc)

#Segmentacion por histograma:

hist=cv.calcHist([gray],[0], None, [256],[0,256]).ravel()

#plt.plot(hist)
