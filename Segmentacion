#plt.xlabel('Intensidad (k)')
#plt.ylabel('Frecuencia')
#plt.show()

#Segmentacion Otsu:

T_otsu, mask=cv.threshold(gray,0,255,cv.THRESH_BINARY+cv.THRESH_OTSU)

#print("Umbral Otsu:",T_otsu)

#cv.imshow("Resultado",mask)

#Multiples Regiones:

gris=image[:,:,0]

umbrales=[41,69,127]
clases=np.digitize(gris,umbrales)

niveles=np.linspace(0,255,4).astype(np.uint8)
resultados=niveles[clases]

#Multi Otsu:

multi_umbrales=threshold_multiotsu(gray,classes=4)
multi_clases=np.digitize(gray,bins=multi_umbrales)

multi_niveles=np.linspace(0,255,4).astype(np.uint8)
multi_resultado=multi_niveles[multi_clases]

print('Umbrales:',multi_umbrales)

plt.figure(figsize=(8, 6))
# Usamos 'jet' o 'viridis' para que cada clase tenga un color muy distinto
plt.imshow(multi_resultado, cmap='jet') 
plt.title('Segmentación Multi-Otsu (4 Clases)')
plt.colorbar(label='Nivel de gris asignado')
plt.axis('off')
plt.show()
